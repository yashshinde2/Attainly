  entityId           String?
  version            Int         @default(1)
  parentDocumentId   String?
  createdAt          DateTime    @default(now())
  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  owner            User        @relation(fields: [institutionId, ownerUserId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@unique([institutionId, pathname])
  @@index([institutionId, ownerUserId])
  @@index([institutionId, entityType, entityId])
}

