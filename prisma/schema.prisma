generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EducationLevel {
  TENTH
  TWELFTH
  DEGREE
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum InternshipOfferType {
  NONE
  PPO_OFFERED
  CONVERTED_TO_JOB
}

enum AchievementCategory {
  TECHNICAL
  NON_TECHNICAL
  SPORTS
  CULTURAL
}

enum AchievementStatus {
  PARTICIPATION
  WINNER
}

enum ExperienceType {
  TEACHING
  INDUSTRY
}

enum EventParticipationRole {
  PARTICIPANT
  WINNER
  ORGANIZER
}

enum FacultyEmploymentStatus {
  ACTIVE
  ON_LEAVE
  VISITING
  INACTIVE
}

enum StudentAcademicStatus {
  ACTIVE
  ON_LEAVE
  GRADUATED
  SUSPENDED
  ALUMNI
}

enum PlacementOfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
}

enum GraduateOutcomeType {
  PLACED
  HIGHER_STUDIES
  ENTREPRENEURSHIP
  ALUMNI
  SEEKING
  OTHER
}

model Institution {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  courses     Course[]
  users       User[]
  roles       Role[]
  permissions Permission[]
  events      Event[]
  studentProfiles StudentProfile[]
  studentEducation StudentEducation[]
  achievements Achievement[]
  studentCertifications StudentCertification[]
  studentResearchPapers StudentResearchPaper[]
  studentPatents StudentPatent[]
  studentProjects StudentProject[]
  studentInternships StudentInternship[]
  studentSkills StudentSkill[]
  studentSemesterRecords StudentSemesterRecord[]
  criterionTags CriterionTag[]
  facultyProfiles FacultyProfile[]
  facultyEducation FacultyEducation[]
  facultyExperiences FacultyExperience[]
  facultyCertifications FacultyCertification[]
  facultyResearchPapers FacultyResearchPaper[]
  facultyPatents FacultyPatent[]
  eventParticipations EventParticipation[]
  savedReports SavedReport[]
  documents Document[]
  achievementCategories AchievementCategoryConfig[]
  studentPlacementOffers StudentPlacementOffer[]
  studentGraduateOutcomes StudentGraduateOutcome[]
  facultyDevelopmentPrograms FacultyDevelopmentProgram[]
  facultyTeachingLoads FacultyTeachingLoad[]
  canonicalPublications CanonicalPublication[]
  publicationContributors PublicationContributor[]
  facultyResearchGrants FacultyResearchGrant[]
  facultyConsultancies FacultyConsultancy[]
  facultyContributions FacultyContribution[]
  academicYears AcademicYear[]
  batches Batch[]
  verificationAssignments VerificationAssignment[]
  verificationAuditLogs  VerificationAuditLog[]
  eventCategoryConfigs   EventCategoryConfig[]
  reportSnapshots        ReportSnapshot[]
  inspectionCollections  InspectionCollection[]
  dataCollectionRequests DataCollectionRequest[]
}

model Department {
  id                String           @default(cuid())
  institutionId     String           @map("institution_id")
  name              String
  code              String
  coordinatorUserId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courses       Course[]
  events        Event[]
  students      StudentProfile[]
  faculties     FacultyProfile[]

  @@id([institutionId, id])
  @@unique([institutionId, code])
  @@index([institutionId, name])
}

model Course {
  id            String      @default(cuid())
  institutionId String @map("institution_id")
  departmentId  String
  name          String
  code          String
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department    Department  @relation(fields: [institutionId, departmentId], references: [institutionId, id], onDelete: Cascade)
  students      StudentProfile[]

  @@id([institutionId, id])
  @@unique([institutionId, code])
  @@index([institutionId, departmentId])
}

model User {
  id            String           @default(cuid())
  institutionId String @map("institution_id")
  roleId        String
  email         String
  passwordHash  String?
  firstName          String
  lastName           String
  isActive           Boolean          @default(true)
  mustChangePassword Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  role          Role             @relation(fields: [institutionId, roleId], references: [institutionId, id], onDelete: Restrict)
  student       StudentProfile?
  faculty       FacultyProfile?
  eventEntries  EventParticipation[]
  savedReports  SavedReport[]
  documents     Document[]

  @@id([institutionId, id])
  @@unique([institutionId, email])
  @@index([institutionId, roleId, isActive])
}

model Role {
  id            String           @default(cuid())
  institutionId String @map("institution_id")
  name          String
  key           String
  createdAt     DateTime         @default(now())
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  users         User[]
  rolePermissions RolePermission[]

  @@id([institutionId, id])
  @@unique([institutionId, key])
}

model Permission {
  id            String           @default(cuid())
  institutionId String @map("institution_id")
  key           String
  description   String?
  createdAt     DateTime         @default(now())
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@id([institutionId, id])
  @@unique([institutionId, key])
}

model RolePermission {
  institutionId String @map("institution_id")
  roleId        String
  permissionId  String
  createdAt     DateTime   @default(now())
  role          Role       @relation(fields: [institutionId, roleId], references: [institutionId, id], onDelete: Cascade)
  permission    Permission @relation(fields: [institutionId, permissionId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, roleId, permissionId])
  @@index([institutionId, permissionId])
}

model StudentProfile {
  id                    String                  @default(cuid())
  institutionId         String                  @map("institution_id")
  userId                String
  dateOfBirth           DateTime?
  phone                 String?
  alternateEmail        String?
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?
  bio                   String?
  enrollmentNumber      String?
  departmentId          String?
  courseId              String?
  admissionYear         Int?
  currentSemester       Int?
  batchLabel            String?
  academicStatus        StudentAcademicStatus   @default(ACTIVE)
  linkedinUrl           String?
  githubUrl             String?
  portfolioUrl          String?
  photoUrl              String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  institution           Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user                  User                    @relation(fields: [institutionId, userId], references: [institutionId, id], onDelete: Cascade)
  department            Department?             @relation(fields: [institutionId, departmentId], references: [institutionId, id], onDelete: SetNull)
  course                Course?                 @relation(fields: [institutionId, courseId], references: [institutionId, id], onDelete: SetNull)
  education             StudentEducation[]
  achievements          Achievement[]
  certifications        StudentCertification[]
  researchPapers        StudentResearchPaper[]
  patents               StudentPatent[]
  projects              StudentProject[]
  internships           StudentInternship[]
  skills                StudentSkill[]
  semesterRecords       StudentSemesterRecord[]
  placementOffers       StudentPlacementOffer[]
  graduateOutcome       StudentGraduateOutcome?

  @@id([institutionId, id])
  @@unique([institutionId, userId])
  @@unique([institutionId, enrollmentNumber])
  @@index([institutionId, createdAt])
}

model StudentEducation {
  id              String         @default(cuid())
  institutionId   String @map("institution_id")
  studentProfileId String
  level           EducationLevel
  institutionName String
  boardOrUniversity String?
  courseOrStream  String?
  score           String?
  startYear       Int?
  endYear         Int?
  createdAt       DateTime       @default(now())
  institution     Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentProfile  StudentProfile @relation(fields: [institutionId, studentProfileId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, studentProfileId, level])
}

model Achievement {
  id                 String              @default(cuid())
  institutionId      String @map("institution_id")
  studentProfileId   String
  title              String
  category           AchievementCategory
  categoryCode       String?
  subcategory        String?
  status             AchievementStatus
  participationLevel String?
  teamType           String?
  teamName           String?
  result             String?
  organizer          String?
  role               String?
  documentUrls       String[]            @default([])
  verificationStatus VerificationStatus  @default(PENDING)
  verifiedByUserId   String?
  verifiedAt         DateTime?
  rejectionReason    String?
  version            Int                 @default(1)
  description        String?
  awardedAt          DateTime?
  sourceEventId      String?
  createdAt          DateTime            @default(now())
  institution        Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentProfile     StudentProfile     @relation(fields: [institutionId, studentProfileId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@unique([institutionId, studentProfileId, sourceEventId])
  @@index([institutionId, studentProfileId, category, status])
}

model StudentCertification {
  id                 String             @default(cuid())
  institutionId      String @map("institution_id")
  studentProfileId   String
  name               String
  issuer             String?
  credentialId       String?
  credentialUrl      String?
  duration           String?
  fileUrl            String?
  issuedAt           DateTime?
  expiresAt          DateTime?
  skillsEarned       String[]           @default([])
  verificationStatus VerificationStatus @default(PENDING)
  verifiedByUserId   String?
  verifiedAt         DateTime?
  rejectionReason    String?
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  institution        Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentProfile     StudentProfile @relation(fields: [institutionId, studentProfileId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, studentProfileId])
}

model StudentResearchPaper {
  id                 String             @default(cuid())
  institutionId      String @map("institution_id")
  studentProfileId   String
  title              String
  publication        String?
  doi                String?
  fileUrl            String?
  publishedAt        DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedByUserId   String?
  verifiedAt         DateTime?
  rejectionReason    String?
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  institution        Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentProfile     StudentProfile @relation(fields: [institutionId, studentProfileId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, studentProfileId])
}

model StudentPatent {
  id                 String             @default(cuid())
  institutionId      String @map("institution_id")
  studentProfileId   String
  title              String
  patentNumber       String?
  status             String?
  fileUrl            String?
  filedAt            DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedByUserId   String?
  verifiedAt         DateTime?
  rejectionReason    String?
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  institution        Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentProfile     StudentProfile @relation(fields: [institutionId, studentProfileId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, studentProfileId])
}

model StudentProject {
  id               String         @default(cuid())
  institutionId    String @map("institution_id")
  studentProfileId String
  title            String
  description      String?
  teamMembers      String?
  facultyGuide     String?
  techStack        String[]       @default([])
  outcomes         String?
  evidenceUrl      String?
  repositoryUrl    String?
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime       @default(now())
  institution      Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile @relation(fields: [institutionId, studentProfileId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, studentProfileId])
}

model StudentInternship {
  id                 String              @default(cuid())
  institutionId      String @map("institution_id")
  studentProfileId   String
  organization       String
  companyLocation    String?
  role               String?
  facultyGuide       String?
  techStack          String[]            @default([])
  description        String?
  outcomes           String?
  evidenceUrl        String?
  startDate          DateTime?
  endDate            DateTime?
  stipendAmount      String?
  offerType          InternshipOfferType @default(NONE)
  verificationStatus VerificationStatus  @default(PENDING)
  verifiedByUserId   String?
  verifiedAt         DateTime?
  rejectionReason    String?
  version            Int                 @default(1)
  createdAt          DateTime            @default(now())
  institution        Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentProfile     StudentProfile @relation(fields: [institutionId, studentProfileId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, studentProfileId])
}

model StudentSkill {
  id               String           @default(cuid())
  institutionId    String           @map("institution_id")
  studentProfileId String
  skillName        String
  proficiency      SkillProficiency @default(INTERMEDIATE)
  createdAt        DateTime         @default(now())
  institution      Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile   @relation(fields: [institutionId, studentProfileId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, studentProfileId])
}

model StudentSemesterRecord {
  id               String         @default(cuid())
  institutionId    String         @map("institution_id")
  studentProfileId String
  semesterNumber   Int
  sgpa             Float
  cgpaAtSemester   Float
  backlogCount     Int?           @default(0)
  createdAt        DateTime       @default(now())
  institution      Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile @relation(fields: [institutionId, studentProfileId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@unique([institutionId, studentProfileId, semesterNumber])
  @@index([institutionId, studentProfileId])
}

model CriterionTag {
  id            String      @default(cuid())
  institutionId String      @map("institution_id")
  itemType      String
  itemId        String
  criterionCode String
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, itemType, itemId])
  @@index([institutionId, criterionCode])
}

model FacultyProfile {
  id                     String                      @default(cuid())
  institutionId          String                      @map("institution_id")
  userId                 String
  employeeId             String?
  departmentId           String?
  designation            String?
  employmentStatus       FacultyEmploymentStatus     @default(ACTIVE)
  employmentType         String?
  joiningDate            DateTime?
  specialization         String?
  bio                    String?
  phone                  String?
  office                 String?
  photoUrl               String?
  linkedinUrl            String?
  researchGateOrOrcidUrl String?
  orcidId                String?
  googleScholarUrl       String?
  scopusAuthorId         String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  institution            Institution                 @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user                   User                        @relation(fields: [institutionId, userId], references: [institutionId, id], onDelete: Cascade)
  department             Department?                 @relation(fields: [institutionId, departmentId], references: [institutionId, id], onDelete: SetNull)
  education              FacultyEducation[]
  experiences            FacultyExperience[]
  certifications         FacultyCertification[]
  researchPapers         FacultyResearchPaper[]
  patents                FacultyPatent[]
  developmentPrograms    FacultyDevelopmentProgram[]
  teachingLoads          FacultyTeachingLoad[]
  publicationLinks       PublicationContributor[]
  researchGrants         FacultyResearchGrant[]
  consultancies          FacultyConsultancy[]
  contributions          FacultyContribution[]

  @@id([institutionId, id])
  @@unique([institutionId, userId])
  @@unique([institutionId, employeeId])
}

model FacultyEducation {
  id               String         @default(cuid())
  institutionId    String @map("institution_id")
  facultyProfileId String
  qualification    String
  institutionName  String
  fieldOfStudy     String?
  yearCompleted    Int?
  createdAt        DateTime       @default(now())
  institution      Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  facultyProfile   FacultyProfile @relation(fields: [institutionId, facultyProfileId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, facultyProfileId])
}

model FacultyExperience {
  id               String         @default(cuid())
  institutionId    String @map("institution_id")
  facultyProfileId String
  type             ExperienceType
  organization     String
  title            String
  description      String?
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime       @default(now())
  institution      Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  facultyProfile   FacultyProfile @relation(fields: [institutionId, facultyProfileId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, facultyProfileId, type])
}

model FacultyCertification {
  id                 String             @default(cuid())
  institutionId      String @map("institution_id")
  facultyProfileId   String
  name               String
  issuer             String?
  fileUrl            String?
  issuedAt           DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedByUserId   String?
  verifiedAt         DateTime?
  rejectionReason    String?
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  institution        Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  facultyProfile     FacultyProfile @relation(fields: [institutionId, facultyProfileId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, facultyProfileId])
}

model FacultyResearchPaper {
  id                 String             @default(cuid())
  institutionId      String @map("institution_id")
  facultyProfileId   String
  title              String
  publication        String?
  doi                String?
  fileUrl            String?
  publishedAt        DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedByUserId   String?
  verifiedAt         DateTime?
  rejectionReason    String?
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  institution        Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  facultyProfile     FacultyProfile @relation(fields: [institutionId, facultyProfileId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, facultyProfileId])
}

model FacultyPatent {
  id                 String             @default(cuid())
  institutionId      String @map("institution_id")
  facultyProfileId   String
  title              String
  patentNumber       String?
  status             String?
  fileUrl            String?
  filedAt            DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedByUserId   String?
  verifiedAt         DateTime?
  rejectionReason    String?
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  institution        Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  facultyProfile     FacultyProfile @relation(fields: [institutionId, facultyProfileId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, facultyProfileId])
}

model EventCategoryConfig {
  id            String      @default(cuid())
  institutionId String      @map("institution_id")
  code          String
  label         String
  subcategories String[]    @default([])
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([institutionId, id])
  @@unique([institutionId, code])
}

model Event {
  id                         String               @default(cuid())
  institutionId              String               @map("institution_id")
  departmentId               String
  title                      String
  description                String?
  type                       String
  categoryCode               String?
  subcategory                String?
  status                     String               @default("PUBLISHED")
  coordinatorUserId          String?
  venue                      String?
  mode                       String               @default("OFFLINE")
  level                      String               @default("INSTITUTION")
  startsAt                   DateTime
  endsAt                     DateTime
  registrationDeadline       DateTime?
  capacity                   Int?
  allowTeamRegistration      Boolean              @default(false)
  maxTeamSize                Int?
  eligibilityRoles           String[]             @default(["STUDENT", "FACULTY"])
  eligibleDepartmentIds      String[]             @default([])
  eligibleBatches            Int[]                @default([])
  supportingDocUrls          String[]             @default([])
  certificateTemplateEnabled Boolean              @default(false)
  completionSummary          String?
  completionReportUrl        String?
  completionPhotoUrls        String[]             @default([])
  feedbackSummary            String?
  completedAt                DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  institution                Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department                 Department           @relation(fields: [institutionId, departmentId], references: [institutionId, id], onDelete: Cascade)
  participation              EventParticipation[]

  @@id([institutionId, id])
  @@index([institutionId, departmentId, startsAt])
  @@index([institutionId, status, startsAt])
}

model EventParticipation {
  id                   String                 @default(cuid())
  institutionId        String                 @map("institution_id")
  eventId              String
  userId               String
  role                 EventParticipationRole
  registrationStatus   String                 @default("REGISTERED")
  attendanceStatus     String                 @default("PENDING")
  teamName             String?
  teamRole             String?
  position             String?
  certificateUrl       String?
  certificateRef       String?
  syncedAchievementId  String?
  syncedContributionId String?
  confirmedAt          DateTime?
  confirmedByUserId    String?
  notes                String?
  createdAt            DateTime               @default(now())
  institution          Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  event                Event                  @relation(fields: [institutionId, eventId], references: [institutionId, id], onDelete: Cascade)
  user                 User                   @relation(fields: [institutionId, userId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@unique([institutionId, eventId, userId])
  @@index([institutionId, eventId, role])
  @@index([institutionId, eventId, registrationStatus])
}

model SavedReport {
  id              String      @default(cuid())
  institutionId   String      @map("institution_id")
  name            String
  entityType      String
  filters         Json
  createdByUserId String
  createdAt       DateTime    @default(now())
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy       User        @relation(fields: [institutionId, createdByUserId], references: [institutionId, id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, createdAt])
}

model ReportSnapshot {
  id                String      @default(cuid())
  institutionId     String      @map("institution_id")
  savedReportId     String?
  name              String
  entityType        String
  filters           Json
  metricDefinition  String
  verificationScope String
  rowCount          Int
  payload           Json
  createdByUserId   String
  createdAt         DateTime    @default(now())
  institution       Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, entityType, createdAt])
}

model InspectionCollection {
  id                String      @default(cuid())
  institutionId     String      @map("institution_id")
  framework         String      @default("CUSTOM")
  title             String
  description       String?
  academicYearIds   String[]    @default([])
  departmentIds     String[]    @default([])
  reportIds         String[]    @default([])
  documentIds       String[]    @default([])
  includeUnverified Boolean     @default(false)
  status            String      @default("DRAFT")
  lastExportedAt    DateTime?
  createdByUserId   String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  institution       Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, framework, createdAt])
}

model DataCollectionRequest {
  id               String      @default(cuid())
  institutionId    String      @map("institution_id")
  title            String
  description      String?
  targetType       String      @default("DOCUMENT")
  targetUserId     String
  departmentId     String?
  dueDate          DateTime?
  status           String      @default("PENDING")
  linkedEntityType String?
  linkedEntityId   String?
  linkedDocumentId String?
  requireEvidence  Boolean     @default(false)
  responseNote     String?
  reviewFeedback   String?
  reminderCount    Int         @default(0)
  lastRemindedAt   DateTime?
  createdByUserId  String
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([institutionId, id])
  @@index([institutionId, targetUserId, status])
  @@index([institutionId, status, dueDate])
}

model Document {
